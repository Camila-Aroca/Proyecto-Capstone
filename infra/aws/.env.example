# Configuración local del despliegue en AWS. Copiar a infra/aws/.env (fuera de Git) y completar.
# Los scripts de infra/aws/scripts/ leen este archivo si existe; una variable ya definida
# en la terminal tiene prioridad.

# Cuenta y región
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
# Perfil de la AWS CLI, si no se usa el predeterminado
# AWS_PROFILE=

# Pila y despliegue
SAAD_STACK=Saad
SAAD_ECR_REPO=saad-api
SAAD_API_CPU=512
SAAD_API_MEMORY=2048
SAAD_USAR_PRONOSTICO_DESACTUALIZADO=0

# Correo que recibe las alarmas de CloudWatch (hay que confirmar la suscripción por correo)
SAAD_ALARM_EMAIL=

# Encabezado secreto CloudFront → ALB. desplegar.sh lo genera y lo guarda aquí si falta.
SAAD_ORIGIN_SECRET=

# Referencia (salidas de la pila; los scripts las consultan a CloudFormation)
SAAD_URL=
SAAD_BUCKET_DATOS=
SAAD_BUCKET_SITIO=
SAAD_DISTRIBUCION_ID=
